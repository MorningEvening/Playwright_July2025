<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Open Cart Regression suite" thread-count="2" parallel="tests">

    <listeners>
        <listener class-name="openCart.listener.ExtentReportListener"></listener>
    </listeners>
    <test name="Verify Title and login URL  " >
        <parameter name="browser" value="chromium"></parameter>
        <classes>
            <class name="testcases.HomePageTest"/>
          </classes>
    </test>
    <test name="Verify num of products">
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="testcases.LoginPageTest"></class>
        </classes>
    </test>
</suite>